{
  "hooks": {
     "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/format_python.py"
            }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/block_db_delete.py"
          }
        ]
      }
    ]
  }
}
